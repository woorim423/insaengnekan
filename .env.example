# Groq API 키 (https://console.groq.com → API Keys)
# 이 파일을 복사해 .env 로 저장한 뒤 값을 넣으세요.
#   cp .env.example .env

GROQ_API_KEY=your_groq_api_key_here

# LLM (3노드 그래프) — console.groq.com 모델 목록 기준
# console.groq.com 에서 계정에 보이는 모델명 사용
GROQ_LLM_MODEL=openai/gpt-oss-20b

# STT (버튼 녹음 → 텍스트)
GROQ_STT_MODEL=whisper-large-v3
